# Caddy gets and renews the HTTPS certificates by itself. No certbot, no cron.
# The {$VAR} values come from .env.production.
{
	email {$ACME_EMAIL}
}

# api.yoursite.com  ->  Laravel (through nginx)
{$API_DOMAIN} {
	encode zstd gzip
	reverse_proxy web:80
}

# db.yoursite.com  ->  phpMyAdmin, behind a password prompt.
#
# This one is open to the whole internet, so the browser must get past Caddy's
# own login before phpMyAdmin is even reached. Bots scan for /phpmyadmin all
# day long -- without this they would be hammering the real login page.
{$DB_DOMAIN} {
	basic_auth {
		{$DB_AUTH_USER} {$DB_AUTH_HASH}
	}

	encode zstd gzip
	reverse_proxy phpmyadmin:80
}
