# ===========================================================================
# nginx on the VPS itself -- NOT the nginx inside Docker.
#
# This is the front door of the server: it takes requests for your domains on
# port 80/443 and passes them to the Docker stack on 127.0.0.1:8000 / :8001.
#
# It only listens on port 80 for now. certbot adds HTTPS (443) to it
# afterwards -- see DEPLOY.md, Step 9.
# ===========================================================================

# --- api.yoursite.com  ->  Laravel (the "web" container, 127.0.0.1:8000) -----
server {
    listen 80;
    server_name api.yoursite.com;   # CHANGE to your API domain

    # nginx only accepts 1 MB request bodies by default. Anything bigger gets
    # "413 Request Entity Too Large" before Laravel ever sees it.
    client_max_body_size 20M;

    location / {
        proxy_pass http://127.0.0.1:8000;   # must match "web" ports in docker-compose.prod.yaml

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# --- db.yoursite.com  ->  phpMyAdmin (127.0.0.1:8001), behind a password ----
server {
    listen 80;
    server_name db.yoursite.com;    # CHANGE to your DB_DOMAIN

    # Matches phpMyAdmin's UPLOAD_LIMIT, so importing a .sql file works.
    client_max_body_size 64M;

    location / {
        # The password prompt, in front of phpMyAdmin's own login.
        # Make the file with:  sudo htpasswd -c /etc/nginx/.htpasswd admin
        auth_basic           "Restricted";
        auth_basic_user_file /etc/nginx/.htpasswd;

        proxy_pass http://127.0.0.1:8001;   # must match "phpmyadmin" ports in docker-compose.prod.yaml

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
