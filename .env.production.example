# ===========================================================================
# Copy this to .env.production ON THE SERVER and fill it in:
#
#     cp .env.production.example .env.production
#     nano .env.production
#
# This file is never committed to git -- it holds your real passwords.
# ===========================================================================

# --- Where the site lives. Both must point to the VPS in your DNS. ---------
APP_DOMAIN=yoursite.com
API_DOMAIN=api.yoursite.com
ACME_EMAIL=you@example.com

# The browser calls the API at this address (must be the https API domain).
NEXT_PUBLIC_API_URL=https://api.yoursite.com

# --- Laravel ---------------------------------------------------------------
APP_NAME=Fullstack
APP_ENV=production
# Generate with:  docker compose -f docker-compose.prod.yml run --rm app php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.yoursite.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- Database (CHANGE THESE PASSWORDS) -------------------------------------
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=app_production
DB_USERNAME=laravel
DB_PASSWORD=change-me-to-a-long-random-password
DB_ROOT_PASSWORD=change-me-to-another-long-random-password

# --- Framework defaults ----------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
